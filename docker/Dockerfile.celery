# Dockerfile cho Celery Worker (AI Processing)
FROM python:3.12.6-slim

ARG PIP_INDEX_URL=https://pypi.org/simple

# Metadata
LABEL maintainer="domanhnghiaforwork@gmail.com"
LABEL description="UDKPB - Celery Worker for AI Image Processing"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RUNNING_IN_DOCKER=1 \
    SYSTEM_CONFIG_SUBPROCESS_CONTROL=False \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=15 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

# Set working directory
WORKDIR /app

# Install system dependencies for AI/ML
RUN apt-get update && apt-get install -y --no-install-recommends \
    # MySQL client
    default-libmysqlclient-dev \
    build-essential \
    pkg-config \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libzbar0 \
    # PDF processing
    poppler-utils \
    # OCR runtime
    tesseract-ocr \
    # Git for downloading models
    git \
    wget \
    # Network utilities
    netcat-openbsd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy Docker-specific requirements
COPY docker/requirements.celery.docker.txt /tmp/requirements.celery.docker.txt
COPY docker/requirements.web.docker.txt /tmp/requirements.web.docker.txt

# Install all Python dependencies (including AI libraries)
RUN pip install --upgrade pip setuptools wheel && \
    pip install --retries 15 --timeout 180 --no-build-isolation py-ubjson==0.16.1 && \
    pip install --retries 15 --timeout 180 --prefer-binary -r /tmp/requirements.celery.docker.txt

# Copy project files
COPY UDKPB/kiem_phieu_bau /app/kiem_phieu_bau
COPY UDKPB/ai_core /app/ai_core

# Create necessary directories
WORKDIR /app/kiem_phieu_bau
RUN mkdir -p media logs

# Expose ports (not really needed for Celery, but for monitoring)
EXPOSE 5555

# Default command for Celery worker with gevent pool
CMD ["celery", "-A", "kiem_phieu_bau", "worker", "--pool=gevent", "--concurrency=10", "--loglevel=info", "--max-tasks-per-child=20", "--time-limit=1800", "--soft-time-limit=1500"]
